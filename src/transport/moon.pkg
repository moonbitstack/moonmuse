// The one place a dialect's `Call` becomes bytes on a socket. Everything above it is
// pure, which is what lets the same wire format be tested without a server.

import {
  "moonbitstack/moonmuse",
  "moonbitstack/moonfetch",
  "moonbitstack/moonhttp/method",
  "moonbitlang/core/encoding/utf8",
  "moonbitstack/moonjson",
  "moonbitstack/moonjson/json",
}

warnings = "-29"

options(
  targets: {
    "send.mbt": [ "native", "wasm" ],
    "stream.mbt": [ "native", "wasm" ],
    "stream_wbtest.mbt": [ "native" ],
  },
)

import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/async",
  "moonbitstack/moonnet/tcp",
} for "wbtest"
