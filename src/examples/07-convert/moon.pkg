// The page's converter: one body in, the other three out, computed by the dialects themselves.
// Built for JavaScript only, because that is the one target whose strings cross into a browser
// without a hand-written glue layer.

import {
  "moonbitstack/moonmuse",
  "moonbitstack/moonmuse/openai",
  "moonbitstack/moonmuse/anthropic",
  "moonbitstack/moonmuse/gemini",
  "moonbitstack/moonmuse/ollama",
  "moonbitstack/moonjson/json",
}

supported_targets = "js"

options(
  link: { "js": { "exports": [ "convert" ], "format": "esm" } },
)
