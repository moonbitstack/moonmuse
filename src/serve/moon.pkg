// A gateway: any provider, exported in the four formats this library speaks. The wire shapes
// come from the dialects the client already uses, so a format is written once and both
// directions are the same code.

// The streaming test needs the three clients and a socket, which two targets have no
// transport for, so its file is limited to native and this package tolerates the imports
// that leaves unused elsewhere.

warnings = "-29"

import {
  "moonbitstack/moonmuse",
  "moonbitstack/moonmuse/openai",
  "moonbitstack/moonmuse/anthropic",
  "moonbitstack/moonasgi",
  "moonbitstack/moonasgi/http",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

import {
  "moonbitstack/moonasgi/testing",
  "moonbitstack/moonmuse/count",
  "moonbitstack/moonmuse/gemini",
  "moonbitstack/moonmuse/ollama",
  "moonbitstack/moonmuse/fake",
  "moonbitstack/moontoken",
  "moonbitstack/moontoken/refused",
  "moonbitstack/moontoken/vocab",
  "moonbitlang/async",
} for "test"

import {
  "moonbitstack/moonasgi/client",
  "moonbitstack/moonasgi/testing",
  "moonbitstack/mooncat",
  "moonbitstack/moonmuse/fake",
  "moonbitstack/moonmuse/openai",
  "moonbitstack/moonmuse/anthropic",
  "moonbitstack/moonmuse/gemini",
  "moonbitstack/moonmuse/ollama",
  "moonbitstack/moonnet/tcp",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/async",
} for "wbtest"

options(
  targets: { "stream_wbtest.mbt": [ "native" ] },
)
